# ==============================================================================
# AI Token Monitor (AI Token 监控平台) - 环境配置模板
# ==============================================================================
# 使用说明：
# 1. 复制本文件并重命名为 `.env`
# 2. 根据您的实际部署环境，修改下方的配置项
# 3. 请确保该 `.env` 文件不要提交到 Git 仓库，以免泄露敏感的数据库凭证
# ==============================================================================

# ==========================================
# 1. 数据库类型配置 (Database Type Selection)
# ==========================================
# 支持的选项：
# - sqlite   : 使用轻量级本地 SQLite 数据库（默认值）
# - postgres : 使用企业级 PostgreSQL 数据库，支持高并发和集中式存储
DATABASE_TYPE=sqlite

# ==========================================
# 2. SQLite 本地数据库配置 (SQLite Settings)
# ==========================================
# 仅当 DATABASE_TYPE=sqlite 时生效。
# - 如果留空，系统将使用默认路径：C:\Users\<您的用户名>\.ai_token_monitor\token_stats.db
# - 如果需要自定义路径，可以填写绝对路径，例如：D:\data\token_stats.db
DB_SQLITE_PATH=

# ==========================================
# 3. PostgreSQL 数据库配置 (PostgreSQL Settings)
# ==========================================
# 仅当 DATABASE_TYPE=postgres 时生效。
# 系统支持两种方式配置 PostgreSQL：
# 方式 A：分项配置（推荐，配置更清晰明了）
# 方式 B：完整连接串（DATABASE_URL）配置

# --- 方式 A：分项配置 ---
# 数据库主机地址 (例如: localhost 或 127.0.0.1)
DB_PG_HOST=127.0.0.1
# 数据库端口号 (默认: 5432)
DB_PG_PORT=5432
# 数据库用户名
DB_PG_USER=postgres
# 数据库密码
DB_PG_PASSWORD=your_password_here
# 数据库名称
DB_PG_DATABASE=token_monitor

# --- 方式 B：完整连接串（备用/群组配置） ---
# 如果填写了上方的分项配置，系统会优先根据分项配置拼接；
# 如果上方分项配置留空，系统会自动读取并使用下方的完整连接串（DATABASE_URL）。
# 格式为: postgresql://用户名:密码@主机名:端口/数据库名
# DATABASE_URL=postgresql://postgres:your_password_here@127.0.0.1:5432/token_monitor

# ==========================================
# 4. 热同步防抖延迟配置 (Hot Sync Debounce)
# ==========================================
# 检测到物理文件写入变动后的防抖等待延迟时间（单位：毫秒）。
# 适当增加该值可以避免在持续高频写入文件时频繁触发数据库的增量同步。
# 默认值：5000（即 5 秒）
HOTSYNC_DEBOUNCE_MS=5000

